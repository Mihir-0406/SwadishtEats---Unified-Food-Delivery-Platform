# Environment Variables — સ્વાદિષ્ટEats Backend
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Server
PORT=5000
NODE_ENV=development

# Frontend origin (for CORS)
FRONTEND_ORIGIN=http://localhost:5500

# Admin access key (change this before going live!)
ADMIN_KEY=swadisheats-admin-2024

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/swadisheats

# Future: Email notifications (e.g. SendGrid)
# SENDGRID_API_KEY=your_sendgrid_key_here
# NOTIFY_EMAIL=owner@swadisheats.in

# Future: SMS (e.g. MSG91)
# MSG91_AUTH_KEY=your_msg91_key_here
